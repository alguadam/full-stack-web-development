{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm dev",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:\\s+http://localhost:\\d+"
        }
      },
      "group": "build"
    },
    {
      "label": "pnpm build",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "pnpm check",
      "type": "shell",
      "command": "pnpm check",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "pnpm lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "pnpm test",
      "type": "shell",
      "command": "pnpm test -- --run",
      "group": "test"
    },
    {
      "label": "pnpm test:e2e",
      "type": "shell",
      "command": "pnpm test:e2e",
      "group": "test"
    }
  ]
}
